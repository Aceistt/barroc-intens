project "Barroc Intens - Gebruikersbeheer" {
  style {
    device: "desktop"
    density: "compact"
    spacing: "md"
    radius: "md"
    stroke: "thin"
    font: "base"
  }
  colors {
    primary: #586477
    accent: #586477
    control: #586477
    chart: #8794A5
  }
  screen Gebruikersbeheer {
    layout split(sidebar: 248, gap: sm) {
      layout stack(direction: vertical, gap: lg, padding: md) {
        component Heading text: "BARROC INTENS"
        component Text text: "VLAMMEND LEKKERE KOFFIE"
        component Divider
        component SidebarMenu items: "Dashboard,Klanten,Sales,Inkoop,Planning,Onderhoud,Finance,Gebruikers,Instellingen" active: 7
        layout panel(padding: md, gap: sm) {
          component Badge text: "ADMIN" variant: info
          component Text text: "Persoonlijke afdelingsomgeving"
        }
      }
      layout stack(direction: vertical, gap: md, padding: md) {
        component Topbar title: "Barroc Intens" subtitle: "Interne bedrijfsapplicatie" user: "Admin"
        component Breadcrumbs items: "Admin,Gebruikersbeheer"
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout stack(direction: vertical, gap: xs) {
              component Heading text: "Gebruikersbeheer"
              component Text text: "Voeg medewerkers toe en pas rollen aan."
            }
          }
          cell span: 4 {
            layout stack(direction: horizontal, gap: sm) {
              component Button text: "Gebruiker toevoegen" variant: primary
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Accounts" value: "24" caption: "Totaal"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Actief" value: "21" caption: "Toegang"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Geblokkeerd" value: "2" caption: "Geen toegang"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Uitnodiging" value: "1" caption: "Nog open"
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 6 {
            component Input label: "Zoeken" placeholder: "Naam of e-mailadres"
          }
          cell span: 3 {
            component Select label: "Rol" items: "Alle,Admin,Finance,Sales,Inkoop,Maintenance,Planner"
          }
          cell span: 3 {
            component Select label: "Status" items: "Alle,Actief,Geblokkeerd"
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Overzicht"
              component Table columns: "Naam,E-mailadres,Rol,Status,Laatste login" rows: 6 pagination: true actions: "eye,edit"
              component Text text: "S. Verkoper - sales@barroc.nl - Sales - Actief"
            }
          }
          cell span: 4 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Rechten en privacy"
              component List items: "Rollen beperken toegang,Admin beheert gebruikers,Geen openbare registratie"
            }
          }
        }
        component Divider
        component Text text: "LOW-FIDELITY ONTWERP · VOORBEELDGEGEVENS · ROLE-BASED ACCESS"
      }
    }
  }
}
