project "Barroc Intens - Inkoop dashboard" {
  style {
    device: "desktop"
    density: "compact"
    spacing: "md"
    radius: "md"
    stroke: "thin"
    font: "base"
  }
  colors {
    primary: #586477
    accent: #586477
    control: #586477
    chart: #8794A5
  }
  screen InkoopDashboard {
    layout split(sidebar: 248, gap: sm) {
      layout stack(direction: vertical, gap: lg, padding: md) {
        component Heading text: "BARROC INTENS"
        component Text text: "VLAMMEND LEKKERE KOFFIE"
        component Divider
        component SidebarMenu items: "Dashboard,Voorraad,Leveranciers,Inkooporders,Taken,Berichten" active: 0
        layout panel(padding: md, gap: sm) {
          component Badge text: "INKOOP" variant: info
          component Text text: "Persoonlijke afdelingsomgeving"
        }
      }
      layout stack(direction: vertical, gap: md, padding: md) {
        component Topbar title: "Barroc Intens" subtitle: "Interne bedrijfsapplicatie" user: "Inkoop"
        component Breadcrumbs items: "Inkoop,Inkoop dashboard"
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout stack(direction: vertical, gap: xs) {
              component Heading text: "Inkoop dashboard"
              component Text text: "Beheer bestellingen, artikelen en leveranciers"
            }
          }
          cell span: 4 {
            layout stack(direction: horizontal, gap: sm) {
              component Button text: "Inkooporder maken" variant: primary
              component Button text: "Voorraad openen" variant: secondary
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Onder minimum" value: "5" caption: "Actie nodig"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Open bestellingen" value: "8" caption: "3 onderweg"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Leveringen vandaag" value: "2" caption: "Controleer ontvangst"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Leveranciers" value: "13" caption: "Actief"
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Voorraadontwikkeling"
              component Chart type: "bar" height: 190
            }
          }
          cell span: 4 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Aankomende leveringen"
              component List items: "PO-302 koffiebonen,PO-303 reiniger,PO-304 reserveonderdelen"
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Actieoverzicht"
              component List items: "Espressobonen: 12 kg, minimum 20 kg,Reinigingsmiddel: 4 stuks, minimum 10"
            }
          }
          cell span: 4 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Snel naar"
              layout stack(direction: horizontal, gap: sm) {
                component Button text: "Inkooporder maken" variant: primary
                component Button text: "Voorraad openen" variant: secondary
              }
            }
          }
        }
        component Divider
        component Text text: "LOW-FIDELITY ONTWERP · VOORBEELDGEGEVENS · ROLE-BASED ACCESS"
      }
    }
  }
}
