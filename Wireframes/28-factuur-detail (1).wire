project "Barroc Intens - Factuur INV-018" {
  style {
    device: "desktop"
    density: "compact"
    spacing: "md"
    radius: "md"
    stroke: "thin"
    font: "base"
  }
  colors {
    primary: #586477
    accent: #586477
    control: #586477
    chart: #8794A5
  }
  screen FactuurDetail {
    layout split(sidebar: 248, gap: sm) {
      layout stack(direction: vertical, gap: lg, padding: md) {
        component Heading text: "BARROC INTENS"
        component Text text: "VLAMMEND LEKKERE KOFFIE"
        component Divider
        component SidebarMenu items: "Dashboard,Facturen,Betalingen,Rapportages,Taken,Meldingen" active: 1
        layout panel(padding: md, gap: sm) {
          component Badge text: "FINANCE" variant: info
          component Text text: "Persoonlijke afdelingsomgeving"
        }
      }
      layout stack(direction: vertical, gap: md, padding: md) {
        component Topbar title: "Barroc Intens" subtitle: "Interne bedrijfsapplicatie" user: "Finance"
        component Breadcrumbs items: "Finance,Factuur INV-018"
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout stack(direction: vertical, gap: xs) {
              component Heading text: "Factuur INV-018"
              component Text text: "Controleer de factuur en registreer betalingen."
            }
          }
          cell span: 4 {
            layout stack(direction: horizontal, gap: sm) {
              component Button text: "Betaling registreren" variant: primary
              component Button text: "Herinnering" variant: secondary
            }
          }
        }
        component Tabs items: "Factuur,Betalingen,Herinneringen" active: 0
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Factuurregels"
              component Text text: "Klant: Café Noord · Factuurdatum: 01-11-2026"
              component Table columns: "Omschrijving,Aantal,Prijs,Totaal" rows: 4 pagination: true actions: "eye,edit"
              component Text text: "Vervaldatum: 15-11-2026"
              component Stat title: "Factuurbedrag" value: "€ 1.250"
            }
          }
          cell span: 4 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Betaalstatus"
              component Badge text: "Vervallen" variant: danger
              component Text text: "Openstaand: € 1.250"
              component Text text: "Betaald: € 0"
              layout stack(direction: horizontal, gap: sm) {
                component Button text: "Betaling registreren" variant: primary
                component Button text: "Herinnering maken" variant: secondary
              }
            }
          }
        }
        layout card(padding: md, gap: sm) {
          component Heading text: "Betalingshistorie"
          component Table columns: "Datum,Type,Bedrag,Referentie" rows: 3 pagination: true actions: "eye,edit"
        }
        component Divider
        component Text text: "LOW-FIDELITY ONTWERP · VOORBEELDGEGEVENS · ROLE-BASED ACCESS"
      }
    }
  }
}
