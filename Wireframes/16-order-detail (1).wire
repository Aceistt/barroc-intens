project "Barroc Intens - Order SO-201" {
  style {
    device: "desktop"
    density: "compact"
    spacing: "md"
    radius: "md"
    stroke: "thin"
    font: "base"
  }
  colors {
    primary: #586477
    accent: #586477
    control: #586477
    chart: #8794A5
  }
  screen OrderDetail {
    layout split(sidebar: 248, gap: sm) {
      layout stack(direction: vertical, gap: lg, padding: md) {
        component Heading text: "BARROC INTENS"
        component Text text: "VLAMMEND LEKKERE KOFFIE"
        component Divider
        component SidebarMenu items: "Dashboard,Klanten,Leads,Offertes,Orders,Taken,Berichten" active: 4
        layout panel(padding: md, gap: sm) {
          component Badge text: "SALES" variant: info
          component Text text: "Persoonlijke afdelingsomgeving"
        }
      }
      layout stack(direction: vertical, gap: md, padding: md) {
        component Topbar title: "Barroc Intens" subtitle: "Interne bedrijfsapplicatie" user: "Sales"
        component Breadcrumbs items: "Sales,Order SO-201"
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout stack(direction: vertical, gap: xs) {
              component Heading text: "Order SO-201"
              component Text text: "Detailoverzicht van verkoop, levering en orderregels."
            }
          }
          cell span: 4 {
            layout stack(direction: horizontal, gap: sm) {
              component Button text: "Status wijzigen" variant: primary
            }
          }
        }
        component Tabs items: "Order,Levering,Activiteiten,Factuur" active: 0
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Orderregels"
              component Text text: "Klant: Café Noord · Leverdatum: 25-11-2026"
              component Table columns: "Artikel,Aantal,Prijs,Regeltotaal" rows: 4 pagination: true actions: "eye,edit"
              component Stat title: "Ordertotaal" value: "€ 2.100"
            }
          }
          cell span: 4 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Status en acties"
              component Badge text: "In behandeling" variant: info
              component Text text: "Leveradres: Breda"
              component Text text: "Contact: S. Janssen"
              layout stack(direction: horizontal, gap: sm) {
                component Button text: "Status wijzigen" variant: primary
                component Button text: "Print overzicht" variant: secondary
              }
            }
          }
        }
        layout card(padding: md, gap: sm) {
          component Heading text: "Logboek"
          component List items: "19-11 Order aangemaakt,20-11 Levering gepland"
        }
        component Divider
        component Text text: "LOW-FIDELITY ONTWERP · VOORBEELDGEGEVENS · ROLE-BASED ACCESS"
      }
    }
  }
}
