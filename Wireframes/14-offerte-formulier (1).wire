project "Barroc Intens - Nieuwe offerte" {
  style {
    device: "desktop"
    density: "compact"
    spacing: "md"
    radius: "md"
    stroke: "thin"
    font: "base"
  }
  colors {
    primary: #586477
    accent: #586477
    control: #586477
    chart: #8794A5
  }
  screen OfferteFormulier {
    layout split(sidebar: 248, gap: sm) {
      layout stack(direction: vertical, gap: lg, padding: md) {
        component Heading text: "BARROC INTENS"
        component Text text: "VLAMMEND LEKKERE KOFFIE"
        component Divider
        component SidebarMenu items: "Dashboard,Klanten,Leads,Offertes,Orders,Taken,Berichten" active: 3
        layout panel(padding: md, gap: sm) {
          component Badge text: "SALES" variant: info
          component Text text: "Persoonlijke afdelingsomgeving"
        }
      }
      layout stack(direction: vertical, gap: md, padding: md) {
        component Topbar title: "Barroc Intens" subtitle: "Interne bedrijfsapplicatie" user: "Sales"
        component Breadcrumbs items: "Sales,Nieuwe offerte"
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout stack(direction: vertical, gap: xs) {
              component Heading text: "Nieuwe offerte"
              component Text text: "Stel offertegegevens en regels samen."
            }
          }
          cell span: 4 {
            layout stack(direction: horizontal, gap: sm) {
              component Button text: "Concept bewaren" variant: primary
              component Button text: "Versturen" variant: secondary
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Offertegegevens"
              layout grid(columns: 12, gap: md) {
                cell span: 6 {
                  component Select label: "Klant" items: "Café Noord,Bistro Zuid,Koffiehuis West"
                }
                cell span: 6 {
                  component Input label: "Geldig tot" placeholder: "dd-mm-jjjj"
                }
              }
              component Input label: "Onderwerp" placeholder: "Nieuwe koffiemachine"
              component Heading text: "Offerteartikelen"
              component Table columns: "Artikel,Aantal,Stuksprijs,Regeltotaal" rows: 3 pagination: true actions: "eye,edit"
              component Button text: "Artikel toevoegen" variant: primary
              component Textarea label: "Opmerkingen en voorwaarden" rows: 3
              layout stack(direction: horizontal, gap: sm) {
                component Button text: "Concept bewaren" variant: primary
                component Button text: "Offerte versturen" variant: secondary
              }
            }
          }
          cell span: 4 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Samenvatting"
              component Text text: "Subtotaal      € 0,00"
              component Text text: "BTW                 € 0,00"
              component Divider
              component Stat title: "Totaal" value: "€ 0,00"
              component Alert title: "Concept" text: "Nog niet verzonden" variant: info
            }
          }
        }
        component Divider
        component Text text: "LOW-FIDELITY ONTWERP · VOORBEELDGEGEVENS · ROLE-BASED ACCESS"
      }
    }
  }
}
