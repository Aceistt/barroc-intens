project "Barroc Intens - Storingen" {
  style {
    device: "desktop"
    density: "compact"
    spacing: "md"
    radius: "md"
    stroke: "thin"
    font: "base"
  }
  colors {
    primary: #586477
    accent: #586477
    control: #586477
    chart: #8794A5
  }
  screen Storingen {
    layout split(sidebar: 248, gap: sm) {
      layout stack(direction: vertical, gap: lg, padding: md) {
        component Heading text: "BARROC INTENS"
        component Text text: "VLAMMEND LEKKERE KOFFIE"
        component Divider
        component SidebarMenu items: "Dashboard,Storingen,Werkbonnen,Planning,Taken,Berichten" active: 1
        layout panel(padding: md, gap: sm) {
          component Badge text: "MAINTENANCE" variant: info
          component Text text: "Persoonlijke afdelingsomgeving"
        }
      }
      layout stack(direction: vertical, gap: md, padding: md) {
        component Topbar title: "Barroc Intens" subtitle: "Interne bedrijfsapplicatie" user: "Maintenance"
        component Breadcrumbs items: "Maintenance,Storingen"
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout stack(direction: vertical, gap: xs) {
              component Heading text: "Storingen"
              component Text text: "Meldingen van defecte machines en opvolging."
            }
          }
          cell span: 4 {
            layout stack(direction: horizontal, gap: sm) {
              component Button text: "Storing melden" variant: primary
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Open" value: "6" caption: "Meldingen"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Urgent" value: "2" caption: "Direct actie"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "In behandeling" value: "3" caption: "Monteur bezig"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Opgelost" value: "11" caption: "Deze maand"
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 6 {
            component Input label: "Zoeken" placeholder: "Nummer, klant of machine"
          }
          cell span: 3 {
            component Select label: "Prioriteit" items: "Alle,Normaal,Hoog,Urgent"
          }
          cell span: 3 {
            component Select label: "Status" items: "Alle,Open,Gepland,Opgelost"
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Overzicht"
              component Table columns: "Nummer,Klant,Machine,Prioriteit,Status" rows: 6 pagination: true actions: "eye,edit"
              component Text text: "ST-041: Café Noord - lekkage espressomachine - Hoog"
            }
          }
          cell span: 4 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Eerst oppakken"
              component List items: "ST-041 lekkage,ST-043 stroomstoring,ST-040 wacht op onderdelen"
            }
          }
        }
        component Divider
        component Text text: "LOW-FIDELITY ONTWERP · VOORBEELDGEGEVENS · ROLE-BASED ACCESS"
      }
    }
  }
}
