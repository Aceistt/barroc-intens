project "Barroc Intens - Geen zoekresultaten" {
  style {
    device: "desktop"
    density: "compact"
    spacing: "md"
    radius: "md"
    stroke: "thin"
    font: "base"
  }
  colors {
    primary: #586477
    accent: #586477
    control: #586477
    chart: #8794A5
  }
  screen LeegOverzicht {
    layout split(sidebar: 248, gap: sm) {
      layout stack(direction: vertical, gap: lg, padding: md) {
        component Heading text: "BARROC INTENS"
        component Text text: "VLAMMEND LEKKERE KOFFIE"
        component Divider
        component SidebarMenu items: "Dashboard,Taken,Berichten,Meldingen,Instellingen" active: 0
        layout panel(padding: md, gap: sm) {
          component Badge text: "MEDEWERKER" variant: info
          component Text text: "Persoonlijke afdelingsomgeving"
        }
      }
      layout stack(direction: vertical, gap: md, padding: md) {
        component Topbar title: "Barroc Intens" subtitle: "Interne bedrijfsapplicatie" user: "Medewerker"
        component Breadcrumbs items: "Medewerker,Geen zoekresultaten"
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout stack(direction: vertical, gap: xs) {
              component Heading text: "Geen zoekresultaten"
              component Text text: "Een lege toestand met duidelijke herstelactie."
            }
          }
          cell span: 4 {
            layout stack(direction: horizontal, gap: sm) {
              component Button text: "Filters wissen" variant: primary
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 6 {
            component Input label: "Zoeken" placeholder: "Zoek een klant, order of nummer"
          }
          cell span: 6 {
            component Select label: "Status" items: "Alle,Open,Afgerond"
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 2 {
            component Text text: " "
          }
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Geen resultaten gevonden"
              component Text text: "Er zijn geen items die overeenkomen met de huidige zoekopdracht."
              component Text text: "Probeer een andere zoekterm of wis de filters."
              layout stack(direction: horizontal, gap: sm) {
                component Button text: "Filters wissen" variant: primary
                component Button text: "Nieuw item toevoegen" variant: secondary
              }
            }
          }
          cell span: 2 {
            component Text text: " "
          }
        }
        component Divider
        component Text text: "LOW-FIDELITY ONTWERP · VOORBEELDGEGEVENS · ROLE-BASED ACCESS"
      }
    }
  }
}
