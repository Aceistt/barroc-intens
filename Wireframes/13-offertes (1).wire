project "Barroc Intens - Offertes" {
  style {
    device: "desktop"
    density: "compact"
    spacing: "md"
    radius: "md"
    stroke: "thin"
    font: "base"
  }
  colors {
    primary: #586477
    accent: #586477
    control: #586477
    chart: #8794A5
  }
  screen Offertes {
    layout split(sidebar: 248, gap: sm) {
      layout stack(direction: vertical, gap: lg, padding: md) {
        component Heading text: "BARROC INTENS"
        component Text text: "VLAMMEND LEKKERE KOFFIE"
        component Divider
        component SidebarMenu items: "Dashboard,Klanten,Leads,Offertes,Orders,Taken,Berichten" active: 3
        layout panel(padding: md, gap: sm) {
          component Badge text: "SALES" variant: info
          component Text text: "Persoonlijke afdelingsomgeving"
        }
      }
      layout stack(direction: vertical, gap: md, padding: md) {
        component Topbar title: "Barroc Intens" subtitle: "Interne bedrijfsapplicatie" user: "Sales"
        component Breadcrumbs items: "Sales,Offertes"
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout stack(direction: vertical, gap: xs) {
              component Heading text: "Offertes"
              component Text text: "Maak, verstuur en volg offertes."
            }
          }
          cell span: 4 {
            layout stack(direction: horizontal, gap: sm) {
              component Button text: "Nieuwe offerte" variant: primary
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 6 {
            component Input label: "Zoeken" placeholder: "Offertenummer of klant"
          }
          cell span: 3 {
            component Select label: "Status" items: "Alle,Concept,Verzonden,Geaccepteerd"
          }
          cell span: 3 {
            component Select label: "Periode" items: "Deze maand,Alle"
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Overzicht"
              component Table columns: "Offertenr,Klant,Totaal,Datum,Status" rows: 6 pagination: true actions: "eye,edit"
              component Text text: "OFF-104: Bistro Zuid - € 3.500 - Verzonden"
            }
          }
          cell span: 4 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Offertestatus"
              component List items: "Concept: nog niet verstuurd,Verzonden: reactie afwachten,Geaccepteerd: omzetten naar order"
            }
          }
        }
        component Divider
        component Text text: "LOW-FIDELITY ONTWERP · VOORBEELDGEGEVENS · ROLE-BASED ACCESS"
      }
    }
  }
}
