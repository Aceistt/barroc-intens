project "Barroc Intens - Klanten" {
  style {
    device: "desktop"
    density: "compact"
    spacing: "md"
    radius: "md"
    stroke: "thin"
    font: "base"
  }
  colors {
    primary: #586477
    accent: #586477
    control: #586477
    chart: #8794A5
  }
  screen KlantenOverzicht {
    layout split(sidebar: 248, gap: sm) {
      layout stack(direction: vertical, gap: lg, padding: md) {
        component Heading text: "BARROC INTENS"
        component Text text: "VLAMMEND LEKKERE KOFFIE"
        component Divider
        component SidebarMenu items: "Dashboard,Klanten,Leads,Offertes,Orders,Taken,Berichten" active: 1
        layout panel(padding: md, gap: sm) {
          component Badge text: "SALES" variant: info
          component Text text: "Persoonlijke afdelingsomgeving"
        }
      }
      layout stack(direction: vertical, gap: md, padding: md) {
        component Topbar title: "Barroc Intens" subtitle: "Interne bedrijfsapplicatie" user: "Sales"
        component Breadcrumbs items: "Sales,Klanten"
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout stack(direction: vertical, gap: xs) {
              component Heading text: "Klanten"
              component Text text: "Doorzoek klanten en beheer hun gegevens."
            }
          }
          cell span: 4 {
            layout stack(direction: horizontal, gap: sm) {
              component Button text: "Nieuwe klant" variant: primary
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 6 {
            component Input label: "Zoeken" placeholder: "Klantnaam of nummer"
          }
          cell span: 3 {
            component Select label: "Status" items: "Alle,Actief,Inactief"
          }
          cell span: 3 {
            component Select label: "Regio" items: "Alle,West,Noord,Zuid"
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Overzicht"
              component Table columns: "Klantnr,Bedrijf,Plaats,Contact,Status" rows: 6 pagination: true actions: "eye,edit"
              component Text text: "Bijv. K-001 Café Noord (Breda), K-002 Bistro Zuid (Tilburg)"
            }
          }
          cell span: 4 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Klantacties"
              component List items: "Klantkaart openen,Nieuwe offerte aanmaken,Contactmoment vastleggen"
            }
          }
        }
        component Divider
        component Text text: "LOW-FIDELITY ONTWERP · VOORBEELDGEGEVENS · ROLE-BASED ACCESS"
      }
    }
  }
}
