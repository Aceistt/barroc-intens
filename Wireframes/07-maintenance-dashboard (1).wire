project "Barroc Intens - Maintenance dashboard" {
  style {
    device: "desktop"
    density: "compact"
    spacing: "md"
    radius: "md"
    stroke: "thin"
    font: "base"
  }
  colors {
    primary: #586477
    accent: #586477
    control: #586477
    chart: #8794A5
  }
  screen MaintenanceDashboard {
    layout split(sidebar: 248, gap: sm) {
      layout stack(direction: vertical, gap: lg, padding: md) {
        component Heading text: "BARROC INTENS"
        component Text text: "VLAMMEND LEKKERE KOFFIE"
        component Divider
        component SidebarMenu items: "Dashboard,Storingen,Werkbonnen,Planning,Taken,Berichten" active: 0
        layout panel(padding: md, gap: sm) {
          component Badge text: "MAINTENANCE" variant: info
          component Text text: "Persoonlijke afdelingsomgeving"
        }
      }
      layout stack(direction: vertical, gap: md, padding: md) {
        component Topbar title: "Barroc Intens" subtitle: "Interne bedrijfsapplicatie" user: "Maintenance"
        component Breadcrumbs items: "Maintenance,Maintenance dashboard"
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout stack(direction: vertical, gap: xs) {
              component Heading text: "Maintenance dashboard"
              component Text text: "Storingen, werkbonnen en de eigen werklijst"
            }
          }
          cell span: 4 {
            layout stack(direction: horizontal, gap: sm) {
              component Button text: "Werkbon openen" variant: primary
              component Button text: "Storing registreren" variant: secondary
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Open meldingen" value: "6" caption: "2 urgent"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Mijn werkbonnen" value: "4" caption: "Vandaag"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Afgehandeld" value: "11" caption: "Deze maand"
            }
          }
          cell span: 3 {
            layout card(padding: md, gap: sm) {
              component Stat title: "Wacht op onderdelen" value: "2" caption: "Inkoop geïnformeerd"
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Storingen per status"
              component Chart type: "bar" height: 190
            }
          }
          cell span: 4 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Mijn volgende bezoeken"
              component List items: "09:00 Café Noord,11:30 Bistro Zuid,14:00 Koffiehuis West"
            }
          }
        }
        layout grid(columns: 12, gap: md) {
          cell span: 8 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Actieoverzicht"
              component List items: "ST-041: lekkage koffiemachine,ST-043: onderdeel nog niet binnen"
            }
          }
          cell span: 4 {
            layout card(padding: md, gap: sm) {
              component Heading text: "Snel naar"
              layout stack(direction: horizontal, gap: sm) {
                component Button text: "Werkbon openen" variant: primary
                component Button text: "Storing registreren" variant: secondary
              }
            }
          }
        }
        component Divider
        component Text text: "LOW-FIDELITY ONTWERP · VOORBEELDGEGEVENS · ROLE-BASED ACCESS"
      }
    }
  }
}
